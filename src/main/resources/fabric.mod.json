{
  "schemaVersion": 1,
  "id": "ephemera",
  "version": "${version}",
  "name": "Ephemera",
  "description": "High-performance Minecraft rendering, culling, memory, lighting, and worldgen engine for native Vulkan and OpenGL — designed as a standalone Fabric mod and the default performance engine for Aurora Launcher.",
  "authors": [
    "Kalib"
  ],
  "contact": {
    "homepage": "https://github.com/kalibsolomon-pixel/Ephemera",
    "sources": "https://github.com/kalibsolomon-pixel/Ephemera",
    "issues": "https://github.com/kalibsolomon-pixel/Ephemera/issues"
  },
  "license": "MIT",
  "icon": "assets/ephemera/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.ephemera.EphemeraCommon"
    ],
    "client": [
      "com.ephemera.EphemeraClient"
    ]
  },
  "mixins": [
    "ephemera.mixins.json",
    {
      "config": "ephemera.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "ephemera.accesswidener",
  "depends": {
    "fabricloader": ">=0.20.0",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  }
}
